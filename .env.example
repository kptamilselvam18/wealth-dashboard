# PostgreSQL connection string.
# Vercel Postgres / Neon / Supabase all work. Use the DIRECT (non-pooled)
# connection string, because `prisma migrate deploy` runs during the build.
DATABASE_URL="postgresql://user:password@host:5432/wealth?schema=public"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: enables the Google sign-in button.
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
