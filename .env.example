# PostgreSQL connection string.
# Vercel Postgres / Neon / Supabase all work. Use the DIRECT (non-pooled)
# connection string, because `prisma migrate deploy` runs during the build.
DATABASE_URL="postgresql://user:password@host:5432/wealth?schema=public"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional: enables the Google sign-in button.
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Market data. `yahoo` (default) uses the public Yahoo Finance chart endpoint
# and MFAPI for Indian fund NAVs. `sample` produces deterministic placeholders
# for local development and is clearly labelled in the UI.
MARKET_DATA_PROVIDER="yahoo"

# Quote cache lifetime in seconds (fund NAVs are cached for 6 hours regardless).
QUOTE_TTL_SECONDS="900"

# Required for scheduled alert evaluation at /api/cron/alerts.
# Generate with: openssl rand -base64 32
CRON_SECRET=""

