generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  image         String?
  googleId      String?
  passwordHash  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  assets        Asset[]      @relation("UserAssets")
  holdings      Holding[]    @relation("UserHoldings")
  transactions  Transaction[] @relation("UserTransactions")
  portfolioSnapshots PortfolioSnapshot[] @relation("UserPortfolioSnapshots")
  goals         Goal[]       @relation("UserGoals")
  liabilities   Liability[]  @relation("UserLiabilities")
  financialProfile  FinancialProfile?
  healthSnapshots   FinancialHealthSnapshot[] @relation("UserHealthSnapshots")
  watchlists        Watchlist[] @relation("UserWatchlists")
  alertEvents       AlertEvent[] @relation("UserAlertEvents")
}

model AssetType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String
  description String?
  assets      Asset[]
}

model Asset {
  id           String   @id @default(cuid())
  userId       String
  assetTypeId  Int
  name         String
  symbol       String?
  isin         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User        @relation("UserAssets", fields: [userId], references: [id], onDelete: Cascade)
  assetType   AssetType   @relation(fields: [assetTypeId], references: [id])
  holdings    Holding[]
  transactions Transaction[]
  priceHistory PriceHistory[]
}

model Holding {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  quantity  Float
  averagePrice Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User   @relation("UserHoldings", fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  INTEREST
  SIP
  DEPOSIT
  WITHDRAWAL
  SPLIT
  BONUS
  OTHER
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  holdingId String?
  type      TransactionType
  quantity  Float
  price     Float
  totalAmount Float
  fee       Float?
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  user      User    @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  holding   Holding? @relation(fields: [holdingId], references: [id], onDelete: SetNull)
}

model PriceHistory {
  id        String   @id @default(cuid())
  assetId   String
  price     Float
  currency  String   @default("INR")
  date      DateTime @default(now())
  source    String?
  createdAt DateTime @default(now())

  asset     Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model PortfolioSnapshot {
  id           String   @id @default(cuid())
  userId       String
  totalValue   Float
  investedValue Float
  pnl          Float
  netWorth     Float?
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User @relation("UserPortfolioSnapshots", fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id               String   @id @default(cuid())
  userId           String
  name             String
  targetAmount     Float
  currentAmount    Float    @default(0)
  targetDate       DateTime
  monthlyContribution Float? @default(0)
  status           GoalStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user            User @relation("UserGoals", fields: [userId], references: [id], onDelete: Cascade)
}

enum GoalStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model Liability {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      LiabilityType
  outstandingAmount Float
  interestRate Float?
  emi       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation("UserLiabilities", fields: [userId], references: [id], onDelete: Cascade)
}

enum LiabilityType {
  CREDIT_CARD
  PERSONAL_LOAN
  EDUCATION_LOAN
  HOME_LOAN
  OTHER
}

// Voluntary inputs used by the financial health score. Missing values stay
// null so the score can treat the factor as unknown instead of poor.
model FinancialProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  monthlyIncome   Float?
  monthlyExpenses Float?
  age             Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One saved check-in. Factors are frozen as JSON so historical scores can be
// explained with the exact values that produced them.
model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation("UserWatchlists", fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
}

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  symbol      String
  name        String
  exchange    String?
  assetType   String   @default("stock")
  currency    String   @default("INR")

  // Last price we know about. `priceSource` records where it came from so the
  // UI can label demo values instead of implying they are live market data.
  price         Float?
  previousPrice Float?
  priceSource   String?
  priceStale    Boolean  @default(false)
  priceUpdatedAt DateTime?

  alertAbove        Float?
  alertBelow        Float?
  alertChangePercent Float?

  // Crossing state, so an alert fires once per crossing instead of every check.
  aboveActive  Boolean @default(false)
  belowActive  Boolean @default(false)
  changeActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  events    AlertEvent[]

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
}

// Provider-independent quote cache. Keys include the provider so switching
// vendors cannot silently serve another source's numbers.
model QuoteCache {
  key           String   @id
  symbol        String
  provider      String
  price         Float
  previousClose Float?
  currency      String
  source        String
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

model AlertEvent {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  type      String
  price     Float
  threshold Float?
  message   String
  createdAt DateTime @default(now())
  readAt    DateTime?

  user User          @relation("UserAlertEvents", fields: [userId], references: [id], onDelete: Cascade)
  item WatchlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FinancialHealthSnapshot {
  id           String   @id @default(cuid())
  userId       String
  score        Float
  financialAge Float?
  coverage     Float
  factors      Json
  createdAt    DateTime @default(now())

  user         User @relation("UserHealthSnapshots", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}